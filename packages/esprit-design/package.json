{
  "name": "@d0rich/esprit-design",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/esprit-design.js": "./dist/index.js",
    "./style.css": "./dist/style.css",
    "./style.tailwind.css": "./dist/style.tailwind.css",
    "./style.pure.css": "./dist/style.pure.css",
    "./dist/style.css": "./dist/style.css",
    "./dist/style.tailwind.css": "./dist/style.tailwind.css",
    "./dist/style.pure.css": "./dist/style.pure.css",
    "./dist/esprit-design.css": "./dist/style.css",
    "./tailwind.config": "./tailwind.config.js",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js",
      "default": "./dist/composables/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./components/*": "./dist/components/*",
    "./composables/*": "./dist/composables/*",
    "./utils/*": "./dist/utils/*",
    "./dist/*": "./dist/*",
    "./src/": "./src/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "@vueuse/core": "^13.2.0",
    "gsap": "^3.12.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.2",
    "vite-plugin-dts": "^4.3.0",
    "vue-router": "^4.5.0"
  }
}
